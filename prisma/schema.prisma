datasource db {
  provider = "postgresql"
  // A kapcsolati URL a prisma.config.ts-ből érkezik (az a .env-ből tölti a DATABASE_URL-t).
}

model Customer {
  id        Int     @id @default(autoincrement())
  name      String
  telepules String
  lat       Float?
  lon       Float?
  budget    Int?
  note      String?

  @@unique([name, telepules])
  @@map("customers")
}
